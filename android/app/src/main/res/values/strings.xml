<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_nombre">🚕 Taxi Conductor</string>
    <string name="pista_url">Dirección del servidor (http://…)</string>
    <string name="pista_telefono">Tu teléfono de conductor (+240…)</string>
    <string name="accion_registrar">Registrar este teléfono</string>
    <string name="accion_entrar_servicio">ENTRAR EN SERVICIO</string>
    <string name="accion_salir_servicio">SALIR DE SERVICIO</string>
    <string name="titulo_oferta">¡Nueva carrera!</string>
    <string name="accion_aceptar">ACEPTAR</string>
    <string name="accion_rechazar">Rechazar</string>
    <string name="accion_llamar">📞 LLAMAR AL PASAJERO</string>
    <string name="accion_salir">VOY DE CAMINO</string>
    <string name="accion_llegado">HE LLEGADO</string>
    <string name="accion_ausente">El pasajero no aparece</string>
    <string name="accion_recoger">PASAJERO RECOGIDO</string>
    <string name="accion_completar">VIAJE TERMINADO</string>
    <string name="ocupacion">Pasajeros: %1$d de %2$d plazas</string>
    <!-- Sin cobertura (migración 057). La PWA ya lo hacía y esta app no:
         «pasajero recogido» sin red daba un error y no se guardaba en ningún
         sitio, con el viaje quedándose abierto y la hora perdida. Ahora se
         guarda con su hora y sale sola al volver la red. -->
    <string name="sin_red_guardada">Sin cobertura: guardado. Se enviará solo al volver la red.</string>
    <string name="sin_red_no_guardada">Sin cobertura y no se pudo guardar. Vuelve a intentarlo.</string>
    <string name="sin_red_pendientes">%1$d por enviar</string>
    <!-- Aceptar y rechazar NO se guardan: valen ahora. Una aceptación de hace
         veinte minutos le quitaría la carrera a otro taxista que ya la hizo. -->
    <string name="sin_red_necesita_red">Para aceptar o rechazar una carrera hace falta red.</string>
    <!-- Oleada 5 (migración 064): la carrera que nadie ha cogido, ofrecida a
         toda la ciudad antes de darla por perdida. -->
    <string name="oferta_nadie_la_ha_cogido">Nadie la ha cogido · puede estar lejos</string>
    <string name="canal_ofertas">Ofertas de carrera</string>
    <string name="rastro_se_guarda">En servicio se guarda por dónde pasas, para tus números y para la central. Fuera de servicio, no se guarda nada. Se borra a los 90 días.</string>
    <string name="canal_servicio">En servicio</string>
    <!-- La notificación dice que se está grabando el recorrido. No es un
         adorno: el taxista lleva el GPS encendido y su recorrido se guarda, y
         tiene derecho a verlo escrito mientras pasa y no a enterarse después
         (P42-01). Además es lo que exige Android para conceder ubicación con
         la pantalla bloqueada: una notificación permanente que lo diga. -->
    <string name="notificacion_en_servicio">En servicio — grabando tu recorrido</string>
    <string name="notificacion_en_servicio_detalle">Se guarda mientras estés en servicio, también sin cobertura. Al salir de servicio se para.</string>
</resources>

# Copia este fichero como `.env` (sin «.ejemplo») y rellena los valores.
# `.env` está en .gitignore: no se sube, y no debe subirse nunca.
#
# Para usarlo, se le pasa a tsx explícitamente:
#   npx tsx --env-file=.env scripts/importar-osm-bioko.ts
#
# Sin BD_URL, todo apunta al Postgres de desarrollo de esta máquina
# (localhost:5433), que es lo que se quiere el 99 % del tiempo. Rellenarlo
# significa «voy a tocar producción»: ponlo solo mientras haga falta.

# Cadena de conexión a la base. La de producción está en Render →
# taxi-malabo → Environment → BD_URL. Cópiala de ahí tal cual.
BD_URL=

# Los UUID de dispositivo que entran al panel de operador, separados por comas.
UUIDS_OPERADOR=
